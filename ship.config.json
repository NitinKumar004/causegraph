{
  "$schema": "https://raw.githubusercontent.com/aryanmehrotra/ship-harness/main/schema/ship.config.schema.json",
  "tracker": {
    "kind": "none"
  },
  "testPaths": [
    "tests/**",
    "test/**",
    "**/*_test.go",
    "**/*_test.py"
  ],
  "attribution": false,
  "setup": {
    "confirmedAt": "2026-08-16"
  },
  "autonomy": {
    "mode": "goal"
  },
  "caps": {
    "research": 3,
    "reviewDelta": 2,
    "spikes": 3,
    "planReviewA": 3,
    "planReviewB": 2,
    "reviewA": 3,
    "reviewB": 2,
    "evidenceFix": 2
  },
  "reviewers": {
    "correctness": "sonnet",
    "design": "opus"
  },
  "collectors": [
    {
      "name": "tests",
      "kind": "builtin:tests",
      "config": {
        "cmd": "make test"
      }
    },
    {
      "name": "cli",
      "kind": "builtin:cmd-golden",
      "config": {
        "cases": [
          {
            "name": "help",
            "cmd": "./scripts/cg --help"
          },
          {
            "name": "tree",
            "cmd": "./scripts/cg tree 100 --db test/fixtures/graph.db"
          },
          {
            "name": "path",
            "cmd": "./scripts/cg path 300 --db test/fixtures/graph.db"
          }
        ],
        "redact": [
          "[0-9]+(\\.[0-9]+)?(ms|s)\\b",
          "/Users/[^/ ]+",
          "/home/[^/ ]+"
        ],
        "timeoutSec": 120
      }
    }
  ]
}
